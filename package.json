{
  "name": "sparql12-gsp-server",
  "version": "0.1.6",
  "license": "MIT",
  "private": false,
  "description": "SPARQL 1.2 Graph Store Protocol Server",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest --runInBand --testPathIgnorePatterns=\"<rootDir>/tests/unit/database/schema\\.spec\\.ts$\" \"<rootDir>/tests/integration/compliance\\.spec\\.ts$\"",
    "test:schema": "jest --runInBand tests/unit/database/schema.spec.ts",
    "test:compliance": "jest --runInBand tests/integration/compliance.spec.ts",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/typeorm": "11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jsonld": "^9.0.0",
    "jsonld-streaming-parser": "^5.0.1",
    "n3": "^2.1.1",
    "pg": "8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rdf-canonize": "^5.0.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sparqljs": "^3.7.4",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@nestjs/testing": "11.1.27",
    "@types/jest": "30.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "@types/node": "26.1.0",
    "@types/pino-http": "^5.8.4",
    "@types/sparqljs": "^3.1.12",
    "@types/supertest": "7.2.0",
    "jest": "30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "multer": "2.2.0"
  }
}
