# Required
GSP_DATABASE_URL=postgresql://localhost:5432/gsp

# Optional — defaults shown
GSP_BASE_URL=http://localhost:3000
GSP_AUTH_ENABLED=true
GSP_AUTH_JWT_SECRET=your-secret-here
GSP_AUTH_API_KEYS=key1,key2
GSP_PATCH_ENABLED=true
GSP_OTEL_ENABLED=false
GSP_OTEL_ENDPOINT=http://localhost:4318
GSP_OTEL_SERVICE_NAME=gsp-server
GSP_MAX_PAYLOAD_SIZE=100MB
GSP_STREAM_THRESHOLD=10MB

# GSP_DEFAULT_GRAPH_PERSISTENT is retired — do not use.
